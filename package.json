{
  "name": "differ",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "differ": "bin/differ.mjs"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/public && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static",
    "start": "next start -H 127.0.0.1",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; p=\"$(git config core.hooksPath)\"; if [ -z \"$p\" ]; then git config core.hooksPath .githooks; elif [ \"$p\" != .githooks ]; then echo \"differ: core.hooksPath is already $p, so differ's pre-push hook isn't installed. CI still runs npm run verify.\" >&2; fi",
    "test": "DIFFER_HOME=\"$(mktemp -d)\" tsx --test \"test/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "picomatch": "^4.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "globals": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
