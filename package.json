{
  "name": "backstory",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "backstory": "bin/backstory.mjs"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/ && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/",
    "start": "next start -H 127.0.0.1",
    "test": "BACKSTORY_HOME=\"$(mktemp -d)\" tsx --test \"test/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "mac:build": "npm run build && bash mac/build.sh",
    "mac:smoke": "node mac/smoke.mjs",
    "mac:dmg": "bash mac/dmg.sh",
    "mac:appcast": "bash mac/appcast.sh",
    "test:mac": "if [ \"$(uname)\" = Darwin ]; then xcodebuild test -quiet -project mac/backstory/Backstory.xcodeproj -scheme Backstory -destination platform=macOS -derivedDataPath mac/build/DerivedData -only-testing:BackstoryTests CODE_SIGNING_ALLOWED=NO; fi",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "verify": "npm run check && npm run build && npm run test:mac"
  },
  "dependencies": {
    "next": "16.4.0",
    "picomatch": "^4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
